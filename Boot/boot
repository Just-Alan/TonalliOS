def rapid_print(text, color=DIM):
    print(color + text + RESET, flush=True)
    time.sleep(0.1)

def clear_screen():
    print(CLEAR, end="", flush=True)

def get_padding():
    width = shutil.get_terminal_size().columns
    max_len = max(len(line) for line in LOGO_TEXT)
    return (width - max_len) // 2

def progress_bar(label="Loading", length=40, delay=0.03):
    pad = " " * get_padding()
    print(AMBER + pad + label + " [" + RESET, end="", flush=True)
    for i in range(length):
        print(AMBER + "▓" + RESET, end="", flush=True)
        time.sleep(delay)
    print(AMBER + "]  DONE" + RESET, flush=True)

def blink_until_enter(text):
    stop = threading.Event()

    def blink():
        while not stop.is_set():
            print(AMBER + text + "█" + RESET, end="\r", flush=True)
            time.sleep(0.5)
            if stop.is_set():
                break
            print(AMBER + text + " " + RESET, end="\r", flush=True)
            time.sleep(0.5)

    t = threading.Thread(target=blink)
    t.start()
    input()
    stop.set()
    t.join()
    print()


def flush_input():
    termios.tcflush(sys.stdin, termios.TCIFLUSH)

def boot_sequence():
    print(HIDE, end="", flush=True)
    clear_screen()
    time.sleep(0.5)

    for msg in BOOT_MESSAGES:
        rapid_print(msg)

    time.sleep(0.3)
    print()
    flush_input()
    blink_until_enter("Press ENTER to continue... ")



def center_block(lines):
    width = shutil.get_terminal_size().columns
    max_len = max(len(line) for line in lines)
    padding = (width - max_len) // 2
    return [(" " * padding) + line for line in lines]


def logo_screen():
    clear_screen()
    time.sleep(0.2)
    centered_logo = center_block(LOGO_TEXT)
    for line in centered_logo:
        print(AMBER + line + RESET, flush=True)
        time.sleep(0.05)

    print()
    time.sleep(0.5)

    progress_bar("  Initializing", length=45, delay=0.05)
    time.sleep(0.5)

    pad = " " * get_padding()
    for _ in range(3):
        print(DIM + pad + "  Launching TonalliOS..." + RESET, flush=True)
        time.sleep(0.5)

    time.sleep(0.5)
    clear_screen()
    

def launcher():
    subprocess.run([sys.executable, "Menu/menu"])

if __name__ == "__main__":
    boot_sequence()
    logo_screen()
    launcher()
